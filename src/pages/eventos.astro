---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { whatsappLink } from '../site.config';

const hoy = new Date();
hoy.setHours(0, 0, 0, 0);

const eventos = (await getCollection('events'))
  .filter((evento) => evento.data.publicado && evento.data.fecha >= hoy)
  .sort((a, b) => a.data.fecha.valueOf() - b.data.fecha.valueOf());
---

<Layout title="Eventos — Tolén">
  <main class="max-w-5xl mx-auto p-8">
    <h1 class="text-3xl font-bold mb-8">Eventos</h1>

    {
      eventos.length === 0 ? (
        <p class="text-base-content/70">No hay eventos programados actualmente.</p>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {eventos.map((evento) => (
            <div class="card bg-base-100 shadow-md">
              <figure>
                <Image src={evento.data.imagen} alt={evento.data.titulo} width={400} class="w-full h-48 object-cover" />
              </figure>
              <div class="card-body">
                <h2 class="card-title">{evento.data.titulo}</h2>
                <p class="text-sm text-base-content/70">
                  {evento.data.fecha.toLocaleDateString('es-ES', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                  })}
                  {evento.data.lugar && ` · ${evento.data.lugar}`}
                </p>
                {evento.data.precio && <span class="badge badge-outline w-fit">{evento.data.precio}</span>}
                <p>{evento.data.descripcion}</p>
                <div class="card-actions justify-end mt-2">
                  <a
                    href={whatsappLink(`Hola, quiero apuntarme a "${evento.data.titulo}"`)}
                    target="_blank"
                    rel="noopener"
                    class="btn btn-primary"
                  >
                    Apúntate por WhatsApp
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      )
    }
  </main>
</Layout>
